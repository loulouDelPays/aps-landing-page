# Copier en .deploy.env sur le serveur (non versionné).
APS_WEB_ROOT=/var/www/aps-logiciel.fr
APS_GIT_BRANCH=main

# Optionnel — si les MP4 ne sont pas déjà dans assets/videos/ sur le serveur
# APS_DEMO_VIDEO_URL=https://…/APS-demo.mp4
# APS_TESTIMONIAL_VIDEO_URL=https://…/testimonials.mp4

# Optionnel — après rsync
# APS_RSYNC_CHOWN=www-data:www-data
