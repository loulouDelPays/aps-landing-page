<div id="consent-banner" class="consent-banner" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-desc" hidden>
  <div class="consent-banner__inner container">
    <div>
      <p id="consent-title" class="consent-banner__title">Cookies et mesure d'audience</p>
      <p id="consent-desc" class="consent-banner__text">Mesure d'audience sans cookies publicitaires (Plausible) et, seulement si vous l'acceptez, mesure Google Ads. Vous pouvez choisir audience seule ou tout refuser — le site reste accessible.</p>
    </div>
    <div class="consent-banner__actions">
      <button type="button" class="btn" id="consent-reject">Tout refuser</button>
      <button type="button" class="btn" id="consent-analytics">Audience uniquement</button>
      <button type="button" class="btn btn--primary" id="consent-accept">Tout accepter</button>
    </div>
  </div>
</div>
