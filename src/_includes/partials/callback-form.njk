<article class="card card--raised ads-callback-card">
  <div class="card__body">
    <h3>Être rappelé</h3>
    <p class="u-text-muted u-mt-2">Pas le temps de choisir un créneau ? Laissez vos coordonnées. {{ site.phoneResponseHint }}.</p>
    <form id="callback-form" class="form js-callback-form" novalidate>
      <input type="text" name="website" class="callback-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form--2">
        <div class="field">
          <label for="callback-first-name">Prénom</label>
          <input type="text" id="callback-first-name" name="contactFirstName" required autocomplete="given-name" />
        </div>
        <div class="field">
          <label for="callback-last-name">Nom</label>
          <input type="text" id="callback-last-name" name="contactLastName" required autocomplete="family-name" />
        </div>
      </div>
      <div class="field">
        <label for="callback-company">Garage</label>
        <input type="text" id="callback-company" name="companyName" required autocomplete="organization" />
      </div>
      <div class="field">
        <label for="callback-phone">Téléphone</label>
        <input type="tel" id="callback-phone" name="contactPhone" required autocomplete="tel" inputmode="tel" />
      </div>
      <div class="field">
        <label for="callback-email">E-mail</label>
        <input type="email" id="callback-email" name="contactEmail" required autocomplete="email" inputmode="email" />
      </div>
      <div class="field field--checkbox">
        <label class="callback-consent">
          <input type="checkbox" id="callback-consent" name="consent" required value="1" />
          <span>J'accepte d'être rappelé pour une démo</span>
        </label>
      </div>
      <p id="callback-form-status" class="hint callback-form-status" role="status" aria-live="polite" hidden></p>
      <button type="submit" class="btn btn--primary btn--lg callback-form-submit">Demander un rappel</button>
    </form>
  </div>
</article>