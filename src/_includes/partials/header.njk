<header class="topbar" id="topbar">
  <div class="container">
    <div class="topbar__inner">
      <a class="brand" href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>
        <span class="brand__mark">
          <img src="/assets/favicon.png" alt="" width="32" height="32" class="brand__logo-icon" decoding="async" />
        </span>
        <span class="brand__text">
          <span class="brand__name">{{ site.name }}</span>
          <span class="brand__tag">{{ site.tagline }}</span>
        </span>
      </a>
      <nav class="nav" aria-label="Navigation principale">
        {% for item in nav.primary %}
        <a href="{{ item.href }}"{% if item.external %} rel="noopener noreferrer"{% endif %}{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="header-actions">
        <a class="btn btn--primary header-actions__cta" href="{{ site.demoUrl }}" rel="noopener noreferrer">Tester sur un dossier</a>
        <button type="button" class="hamburger" id="hamburger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="Navigation mobile" aria-hidden="true">
  {% for item in nav.primary %}
  <a href="{{ item.href }}"{% if item.external %} rel="noopener noreferrer"{% endif %} tabindex="-1">{{ item.label }}</a>
  {% endfor %}
  <a class="btn btn--primary u-mt-3" href="{{ site.demoUrl }}" rel="noopener noreferrer" tabindex="-1">Tester APS sur un de mes dossiers</a>
</nav>
